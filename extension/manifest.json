{
  "manifest_version": 3,
  "name": "Password Manager Autofill",
  "key": "",
  "version": "1.0.0",
  "description": "Secure, completely offline autofill extension that bridges to the Desktop Password Manager.",
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autofill@passwordmanager.com",
      "strict_min_version": "109.0"
    }
  }
}
