# SecureX Firebase Cloud Sync Configuration (Optional)
# If provided, builds will automatically embed these credentials for 1-click Google Sign-In & Firestore push sync.
# Users can also configure or override these directly in the app UI via "Project Configuration".
# To keep your private configuration local, place them in .env (which is ignored by git).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# GitHub Releases Auto-Update Configuration (Optional)
VITE_GITHUB_REPO_OWNER=Nyx3023
VITE_GITHUB_REPO_NAME=Password-Manager-System
