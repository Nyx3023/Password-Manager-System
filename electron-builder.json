{
  "appId": "com.securex.desktop",
  "productName": "SecureX",
  "copyright": "Copyright © 2026 SecureX",
  "directories": {
    "buildResources": "build",
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "extension/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/.cache/**/*",
    "!android/**/*",
    "!src/**/*",
    "!.git/**/*"
  ],
  "extraFiles": [
    {
      "from": "extension",
      "to": "extension",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "executableName": "SecureX",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "publish": {
    "provider": "github",
    "owner": "Nyx3023",
    "repo": "Password-Manager-System"
  }
}
