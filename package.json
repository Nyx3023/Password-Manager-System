{
  "name": "password-manager-system",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Android password vault with biometrics and export/import",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:android": "npm run build && npx cap sync android",
    "cap:add": "npx cap add android",
    "cap:open": "npx cap open android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/share": "^7.0.1",
    "@capawesome/capacitor-file-picker": "^7.2.0",
    "@capgo/capacitor-native-biometric": "^7.1.0",
    "hash-wasm": "^4.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "capacitor": {
    "platforms": ["android"]
  }
}
