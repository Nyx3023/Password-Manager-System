{
  "name": "securex",
  "version": "1.0.0",
  "private": true,
  "description": "SecureX — Offline password vault for Android and Windows desktop",
  "author": "SecureX Team",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "electron:dev": "node desktop/dev.cjs",
    "desktop": "npm run build:desktop && electron .",
    "build": "tsc -p tsconfig.json && vite build",
    "build:desktop": "tsc -p tsconfig.json && vite build --mode desktop",
    "test": "vitest run",
    "pack:win": "npm run build:desktop && npx electron-builder --win --x64 --dir",
    "build:portable": "npm run build:desktop && npx electron-builder --win portable --x64",
    "build:android": "npm run build && npx cap sync android",
    "cap:add": "npx cap add android",
    "cap:open": "npx cap open android",
    "preview": "vite preview",
    "icons:download": "node scripts/download-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/share": "^7.0.1",
    "@capawesome/capacitor-file-picker": "^7.2.0",
    "@capgo/capacitor-native-biometric": "^7.1.0",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vault-autofill": "file:plugins/vault-autofill",
    "vault-lan-http": "file:plugins/vault-lan-http"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.7.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1"
  },
  "capacitor": {
    "platforms": [
      "android"
    ]
  }
}
